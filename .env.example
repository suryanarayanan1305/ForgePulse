# ============================================================
# FORGEPULSE — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git. It is listed in .gitignore.
#
# 12-Factor App: All configuration lives in environment variables.
# ============================================================

# --- Application ---
APP_NAME=ForgePulse
APP_VERSION=1.0.0
APP_ENV=development            # development | staging | production
DEBUG=true

# --- PostgreSQL Database ---
# Local (Docker Compose): hostname is the Docker service name "postgres"
# Production (Render): Set DATABASE_URL directly from Render dashboard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=forgepulse
POSTGRES_USER=forgepulse_user
POSTGRES_PASSWORD=forgepulse_pass

# Optional: Full connection string override (provided by Render in production)
# If set, this takes precedence over the individual POSTGRES_* variables
DATABASE_URL=

# --- MQTT Broker ---
# Local (Docker Compose): hostname is the Docker service name "mosquitto"
# Production: Set to your managed MQTT broker host (HiveMQ Cloud / EMQX Cloud)
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=forgepulse-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_KEEPALIVE=60
MQTT_TOPIC_PREFIX=factory
MQTT_QOS=1

# --- Alert Engine ---
ALERT_COOLDOWN_SECONDS=300     # 5 minutes between same alert type per machine

# --- Analytics ---
ANOMALY_ZSCORE_THRESHOLD=3.0
TELEMETRY_WINDOW_SIZE=50

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- CORS (Frontend origins allowed to call the API) ---
# Local development: React Vite dev server
# Production: Replace with your Vercel domain
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
