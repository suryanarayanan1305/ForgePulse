# ForgePulse — Git Ignore
# ========================

# Environment secrets — NEVER commit these
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
env/
.venv/
ENV/

# SQLAlchemy / Alembic
*.db
*.sqlite3

# Node / Frontend
node_modules/
dist/
.next/
.nuxt/
frontend/.env
frontend/.env.local
frontend/dist/

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Docker volumes (local data mounts)
mosquitto/data/
mosquitto/log/

# Logs
*.log
logs/

# ML model artifacts (regenerated at runtime)
*.pkl
*.joblib
models/*.pkl

# Coverage reports
htmlcov/
.coverage
coverage.xml
